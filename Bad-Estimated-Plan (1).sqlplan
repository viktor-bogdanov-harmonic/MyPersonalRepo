= 1 THEN 'HB'&#xD;&#xA;&#x9;&#x9;WHEN s.IsIPBHoldbackSeries = 1 THEN 'HB'&#xD;&#xA;&#x9;&#x9;ELSE 'Mainline'&#xD;&#xA;&#x9;END AS SeriesType,&#xD;&#xA;&#x9;n.PriceDate,&#xD;&#xA;&#x9;n.NAVDate,&#xD;&#xA;&#x9;n.NNAV,&#xD;&#xA;&#x9;n.GNAV,&#xD;&#xA;&#x9;ISNULL(r.Rate, 1) AS FXRate,&#xD;&#xA;&#x9;n.NAVQuality,&#xD;&#xA;&#x9;c.TransSpecialTypeID,&#xD;&#xA;&#x9;DATEADD(dd, DATEDIFF(dd, 0, ISNULL(c.InitialSubscriptionDate, c.TransDate)), 0) AS LotDate,&#xD;&#xA;&#x9;c.SharesLeft + c.SharesLeftPending AS SharesLeft,&#xD;&#xA;&#x9;CASE WHEN t.IgnoreLockup = 1 AND f.FundApplyLockupRulesToDividendReInvestments = 0 THEN 1 ELSE 0 END AS IgnoreLockup &#xD;&#xA;FROM #TransInfo t&#xD;&#xA;&#x9;INNER JOIN #FundInfo f&#xD;&#xA;&#x9;&#x9;ON f.FundID = t.FundID&#xD;&#xA;&#x9;LEFT JOIN #GroupInfo g&#xD;&#xA;&#x9;&#x9;ON f.GroupID = g.GroupID&#xD;&#xA;&#x9;INNER JOIN #ClassInfo sc&#xD;&#xA;&#x9;&#x9;ON ISNULL(t.ParentShareClassID, t.ShareClassID) = sc.ShareClassID&#xD;&#xA;&#x9;INNER JOIN #SeriesInfo s&#xD;&#xA;&#x9;&#x9;ON t.ShareClassID = s.ShareClassID&#xD;&#xA;&#x9;INNER JOIN #NavInfo n&#xD;&#xA;&#x9;&#x9;ON t.ShareClassID = n.ShareClassID&#xD;&#xA;&#x9;INNER JOIN #ComplianceInfo c&#xD;&#xA;&#x9;&#x9;ON c.TransID = t.TransID&#xD;&#xA;&#x9;LEFT JOIN #FxRates r&#xD;&#xA;&#x9;&#x9;ON n.ShareclassID = r.ShareclassID" StatementId="54" StatementCompId="71" StatementType="SELECT" RetrievedFromCache="true" StatementSubTreeCost="0.130451" StatementEstRows="1" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0x9EDD0EC287838876" QueryPlanHash="0x39D3CD8018640F5D" StatementOptmEarlyAbortReason="GoodEnoughPlanFound" CardinalityEstimationModelVersion="150"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="true" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false" /><QueryPlan CachedPlanSize="320" CompileTime="9" CompileCPU="9" CompileMemory="1048"><MemoryGrantInfo SerialRequiredMemory="2048" SerialDesiredMem