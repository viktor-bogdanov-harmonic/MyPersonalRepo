alarOperator><Identifier><ColumnReference Database="[FM3JPMPE]" Schema="[dbo]" Table="[NAV]" Alias="[n2]" Column="NAVDate" /></Identifier></ScalarOperator><ScalarOperator><Identifier><ColumnReference Database="[FM3JPMPE]" Schema="[dbo]" Table="[NAV]" Alias="[n]" Column="NAVDate" /></Identifier></ScalarOperator></Compare></ScalarOperator><ScalarOperator><Logical Operation="AND"><ScalarOperator><Compare CompareOp="EQ"><ScalarOperator><Identifier><ColumnReference Database="[FM3JPMPE]" Schema="[dbo]" Table="[NAV]" Alias="[n2]" Column="NAVDate" /></Identifier></ScalarOperator><ScalarOperator><Identifier><ColumnReference Database="[FM3JPMPE]" Schema="[dbo]" Table="[NAV]" Alias="[n]" Column="NAVDate" /></Identifier></ScalarOperator></Compare></ScalarOperator><ScalarOperator><Compare CompareOp="LT"><ScalarOperator><Identifier><ColumnReference Database="[FM3JPMPE]" Schema="[dbo]" Table="[NAV]" Alias="[n2]" Column="NAVTypeID" /></Identifier></ScalarOperator><ScalarOperator><Identifier><ColumnReference Database="[FM3JPMPE]" Schema="[dbo]" Table="[NAV]" Alias="[n]" Column="NAVTypeID" /></Identifier></ScalarOperator></Compare></ScalarOperator></Logical></ScalarOperator></Logical></ScalarOperator></Predicate></IndexScan></RelOp></NestedLoops></RelOp></NestedLoops></RelOp></ComputeScalar></RelOp><Predicate><ScalarOperator ScalarString="[FM3JPMPE].[dbo].[NAV].[NAVID] as [n2].[NAVID] IS NULL"><Compare CompareOp="IS"><ScalarOperator><Identifier><ColumnReference Database="[FM3JPMPE]" Schema="[dbo]" Table="[NAV]" Alias="[n2]" Column="NAVID" /></Identifier></ScalarOperator><ScalarOperator><Const ConstValue="NULL" /></ScalarOperator></Compare></ScalarOperator></Predicate></Filter></RelOp></Update></RelOp><ParameterList><ColumnReference Column="@Date" ParameterDataType="datetime" ParameterCompiledValue="*** Redacted ***" /></ParameterList></QueryPlan></StmtSimple><StmtSimple StatementText="&#xD;&#xA;&#xD;&#xA;SELECT&#xD;&#xA;&#x9;T.ShareclassID,&#xD;&#xA;&#x9;ISNULL(&#xD;&#xA;&#x9;&#x9;MAX(CASE WHEN fxr.FundID IS NOT NULL THEN fxr.Rate END), -- Use rate with FundID if possible&#xD;&#xA;&#x9;&#x9;MAX(fxr.Rate)&#xD;&#xA;&#x9;&#x9;) AS Rate &#xD;&#xA;INTO #FxRates&#xD;&#xA;FROM&#xD;&#xA;(&#xD;&#xA;&#x9;SELECT&#xD;&#xA;&#x9;&#x9;n.ShareclassID,&#xD;&#xA;&#x9;&#x9;n.FundID,&#xD;&#xA;&#x9;&#x9;c.CurrencyID,&#xD;&#xA;&#x9;&#x9;MAX(r.[Date]) AS RateDate&#xD;&#xA;&#x9;FROM #NavInfo n&#xD;&#xA;&#x9;INNER JOIN #SeriesIds s&#xD;&#xA;&#x9;&#x9;ON n.ShareClassID = s.ShareClassID&#xD;&#xA;&#x9;INNER JOIN #ClassInfo c&#xD;&#xA;&#x9;&#x9;ON ISNULL(s.ParentShareClassID, s.ShareClassID) = c.ShareClassID&#xD;&#xA;&#x9;INNER JOIN FXRate r&#xD;&#xA;&#x9;&#x9;ON r.[Date] &lt; DATEADD(Day, 1, n.NAVDate)&#xD;&#xA;&#x9;&#x9;AND (r.FundID IS NULL OR r.FundID = n.FundID)&#xD;&#xA;&#x9;&#x9;AND r.ToCurrencyID = 4 -- USD&#xD;&#xA;&#x9;&#x9;AND r.FromCurrencyID = c.CurrencyID&#xD;&#xA;&#x9;&#x9;AND r.FXRateTypeID = 1&#xD;&#xA;&#x9;GROUP BY &#xD;&#xA;&#x9;&#x9;n.ShareclassID,&#xD;&#xA;&#x9;&#x9;n.FundID,&#xD;&#xA;&#x9;&#x9;c.CurrencyID&#xD;&#xA;) T&#xD;&#xA;INNER JOIN FXRate fxr&#xD;&#xA;&#x9;ON (fxr.FundID IS NULL OR fxr.FundID = T.FundID)&#xD;&#xA;&#x9;AND fxr.[Date] = T.RateDate&#xD;&#xA;&#x9;AND fxr.ToCurrencyID = 4 -- USD&#xD;&#xA;&#x9;AND fxr.FromCurrencyID = T.CurrencyID&#xD;&#xA;&#x9;AND fxr.FXRateTypeID = 1&#xD;&#xA;GROUP BY T.ShareclassID" StatementId="53" StatementCompId="70" StatementType="SELECT INTO" RetrievedFromCache="true" StatementSubTreeCost="0.334172" StatementEstRows="8.40729" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0xB52589956D51EA93" QueryPlanHash="0xBD7A28968854E76E" StatementOptmEarlyAbortReason="TimeOut" CardinalityEstimationModelVersion="150"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="true" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false" /><QueryPlan CachedPlanSize="192" CompileTime="17" CompileCPU="17" CompileMemory="1448"><MemoryGrantInfo Seri