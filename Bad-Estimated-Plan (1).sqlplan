&#xD;&#xA;&#x9;&#x9;ON n.ShareClassID = sc.ShareClassID&#xD;&#xA;&#x9;LEFT JOIN TransSub ts&#xD;&#xA;&#x9;&#x9;ON ts.TransID = T.TransID&#xD;&#xA;WHERE T.TransTypeID IN (1, 3, 5) /*Subscription, Transfer In Crystal, Transfer In Uncrystal*/&#xD;&#xA;&#x9;AND T.TransStatusID IN (2, 4) /*, Confirmed, Posted */&#xD;&#xA;&#x9;AND T.TransDate &lt;= @Date&#xD;&#xA;&#x9;AND (@ParentShareClassID IS NULL OR sc.ParentShareClassID = @ParentShareClassID)&#xD;&#xA;GROUP BY&#xD;&#xA;&#x9;T.TransID,&#xD;&#xA;&#x9;T.ShareholderID,&#xD;&#xA;&#x9;n.ShareClassID,&#xD;&#xA;&#x9;sc.ParentShareClassID,&#xD;&#xA;&#x9;n.FundID,&#xD;&#xA;&#x9;sh.AccountLocation,&#xD;&#xA;&#x9;sh.AccountLocationName" StatementId="32" StatementCompId="47" StatementType="SELECT INTO" RetrievedFromCache="true" StatementSubTreeCost="3.22945" StatementEstRows="1" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0x913A8E5C92F4436E" QueryPlanHash="0xFDEC68F3E0B55023" CardinalityEstimationModelVersion="150" BatchModeOnRowStoreUsed="true"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="true" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false" /><QueryPlan NonParallelPlanReason="CouldNotGenerateValidParallelPlan" CachedPlanSize="184" CompileTime="33" CompileCPU="33" CompileMemory="2616"><MemoryGrantInfo SerialRequiredMemory="1176" SerialDesiredMemory="2200" GrantedMemory="0" MaxUsedMemory="0" /><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="1114112" EstimatedPagesCached="2228224" EstimatedAvailableDegreeOfParallelism="6" MaxCompileMemory="255889152" /><OptimizerStatsUsage><StatisticsInfo LastUpdate="2026-10-05T00:44:06.18" ModificationCount="143" SamplingPercent="100" Statistics="[_WA_Sys_NAVStatusID_4C564A9F]" Table="[NAV]" Schema="[dbo]" Database="[FM3JPMPE]" /><StatisticsInfo LastUpdate="2026-10-05T00:42:59.55" ModificationCount="42" SamplingPercent="100" Statistics="[IX_Trans_TransTypeID_TransSpecialTy