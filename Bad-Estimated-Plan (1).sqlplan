reeTypeID&#xD;&#xA;&#x9;&#x9;&#x9;AND pv.ParamTreeID = pt.ParamTreeID&#xD;&#xA;&#x9;&#x9;&#x9;AND pt.Tag = 'JPMSeriesOlympicID'&#xD;&#xA;&#x9;&#x9;INNER JOIN ParameterTreeType ptt&#xD;&#xA;&#x9;&#x9;&#x9;ON pt.ParamTreeTypeID = ptt.ParamTreeTypeID&#xD;&#xA;&#x9;&#x9;&#x9;AND ptt.ParameterTreeCategoryID = 11&#xD;&#xA;&#x9;)&#xD;&#xA;&#x9;&#x9;ON c.ShareClassID = pv.FMObjectID&#x9;&#xD;&#xA;&#x9;LEFT OUTER JOIN ShareClassIdentifiers i&#xD;&#xA;&#x9;&#x9;ON sc.ShareClassID = i.ShareClassID&#xD;&#xA;&#x9;&#x9;AND i.IdentifierTypeID = 17&#x9;&#x9;&#x9;&#x9;&#xD;&#xA;&#x9;LEFT OUTER JOIN ShareClassIdentifiers ic&#xD;&#xA;&#x9;&#x9;ON sc.ShareClassID = ic.ShareClassID&#xD;&#xA;&#x9;&#x9;AND ic.IdentifierTypeID = 5&#xD;&#xA;&#x9;LEFT OUTER JOIN JPMHoldbackCUSIP hc&#xD;&#xA;&#x9;&#x9;ON hc.ShareClassID = sc.ParentShareClassID&#xD;&#xA;&#x9;&#x9;AND ISNULL(ic.SecurityCode, '') &lt;&gt; ''&#xD;&#xA;&#x9;&#x9;AND (ic.SecurityCode = hc.Cusip OR ic.SecurityCode = hc.NonAdvCusip)&#xD;&#xA;&#x9;&#x9;&#xD;&#xA;GROUP BY c.ShareClassID, sc.ShareClassName, sc.IsPreliminary, sc.IsJPMPBAHoldbackSeries, pv.TreeValue" StatementId="51" StatementCompId="68" StatementType="SELECT INTO" RetrievedFromCache="true" StatementSubTreeCost="0.665574" StatementEstRows="26.7117" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0xA1202036AE84CD7D" QueryPlanHash="0x3D15A5B1F7E162A0" StatementOptmEarlyAbortReason="TimeOut" CardinalityEstimationModelVersion="150"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="true" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false" /><QueryPlan CachedPlanSize="208" CompileTime="17" CompileCPU="17" CompileMemory="1992"><MemoryGrantInfo SerialRequiredMemory="1536" SerialDesiredMemory="1760" GrantedMemory="0" MaxUsedMemory="0" /><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="1114112" EstimatedPagesCached="2228224" EstimatedAvailableDegreeOfParallelism="6" MaxCo